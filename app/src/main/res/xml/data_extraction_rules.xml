<?xml version="1.0" encoding="utf-8"?>
<!--
  Security evidence, learned baselines and Keystore-backed material must never leave the device
  through backup or device-to-device transfer. Everything is excluded by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
